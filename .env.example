# Копия этого файла в .env — локальная конфигурация. .env в git не попадает.

# dev: включает вход без Telegram (POST /api/auth/dev). НА СЕРВЕРЕ ОБЯЗАТЕЛЬНО prod.
APP_ENV=dev

# Домен сайта (только для сервера, A-запись должна вести на него): Caddy выпустит HTTPS-сертификат.
DOMAIN=
# Адрес сайта для Mini App и кнопок бота. На сервере: https://<DOMAIN>
PUBLIC_URL=http://localhost:8080
# Версия образов из GHCR на сервере (по умолчанию latest)
TAG=latest

# PostgreSQL
POSTGRES_USER=ladno
POSTGRES_PASSWORD=
POSTGRES_DB=ladno
# Для запуска backend и тестов на хосте; в docker compose адрес подставляется сам.
DATABASE_URL=postgresql+asyncpg://ladno:<POSTGRES_PASSWORD>@localhost:5432/ladno

# Секрет подписи JWT: openssl rand -hex 32
JWT_SECRET=

# Ключ шифрования ФИО, телефона, email и адреса в БД. Потеря ключа = потеря этих данных.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=

# Адреса фронтенда через запятую (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Telegram: токен и имя бота (без @) из @BotFather; BOT_API_TOKEN — общий секрет бота и backend
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Если сервер не достаёт до api.telegram.org (бот пишет «Request timeout error»):
# прокси socks5://user:pass@host:port или http://host:port, либо свой адрес Bot API
TELEGRAM_PROXY=
TELEGRAM_API_URL=
BOT_API_TOKEN=
# Как часто бот проверяет сроки ответа и шлёт напоминания, минут
REMINDER_INTERVAL_MINUTES=30

# Языковая модель: openai (любой OpenAI-совместимый API), ollama или none
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Модель для фото (квитанции, обращения); пусто — LLM_MODEL. Для квитанций лучше gpt-4o
LLM_VISION_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Пусто — OLLAMA_MODEL
OLLAMA_VISION_MODEL=
# Сколько секунд ждать модель; потом приложение работает как без неё (шаблоны и правила)
LLM_TIMEOUT_SECONDS=15
# Для запросов с фото (квитанции, обращения) модели нужно больше времени
LLM_VISION_TIMEOUT_SECONDS=90

# Лимиты на пользователя (0 — без лимита). Окно: час для классификации, остальное — сутки по UTC.
LLM_CLASSIFY_PER_HOUR=20
LLM_RECEIPT_SCANS_PER_DAY=10
LLM_RECEIPT_TEXTS_PER_DAY=30
LLM_ASSISTANT_PER_DAY=30
ISSUES_PER_DAY=20
PHOTOS_PER_DAY=30
# Бюджет на весь сервис: запросов к модели в сутки. Исчерпан — работают шаблоны и ручной ввод
# (в /api/meta: llm_budget_exhausted). 0 — без бюджета.
LLM_DAILY_REQUEST_BUDGET=2000
# Запросов к модели в минуту на пользователя (защита от очередей)
LLM_REQUESTS_PER_MINUTE=20
# Для новых моделей OpenAI (gpt-5, o-серия) нужно max_completion_tokens
LLM_MAX_TOKENS_PARAM=max_tokens
# Входов и попыток входа с одного IP в час
LOGINS_PER_IP_PER_HOUR=20
# Карта скрывает дома, где обращений меньше этого числа (иначе по ним можно узнать автора)
MAP_MIN_ISSUES=3

# Отправка обращений в УК по email (SMTP). Без SMTP_HOST кнопка отправки не показывается.
# SMTP_TLS: starttls (порт 587), ssl (порт 465) или none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=starttls

# true — в интерфейсе помечено, что данные демонстрационные
DEMO_DATA=false

# Публикация портов на хосте при локальном запуске (на сервере не используются)
FRONTEND_PORT=8080
BACKEND_PORT=8000
